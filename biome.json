{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": ["*.js", "ui/**/*.js", "services/**/*.js", "tests/**/*.js"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "assist": {
        "enabled": false
    },
    "javascript": {
        "formatter": {
            "bracketSpacing": false,
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "all"
        },
        "globals": ["setImmediate"]
    }
}
