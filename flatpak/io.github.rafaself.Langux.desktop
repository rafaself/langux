[Desktop Entry]
Name=Langux
Comment=Translate text between languages
Exec=langux
Icon=io.github.rafaself.Langux
Terminal=false
Type=Application
Categories=Utility;
Keywords=translate;translation;language;
StartupNotify=false
Actions=GnomeShellPopup;

[Desktop Action GnomeShellPopup]
Name=Open Langux popup
Exec=langux --gnome-shell-adapter
Icon=io.github.rafaself.Langux
